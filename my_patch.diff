+            const spinner = saveBtn.querySelector('.spinner');
+            
+            saveBtn.disabled = true;
+            spinner.classList.remove('hidden');
+            
+            try {
+                const response = await fetch('/api/profile/update', {
+                    method: 'POST',
+                    headers: { 'Content-Type': 'application/json' },
+                    body: JSON.stringify({
+                        full_name: fullName,
+                        password: password,
+                        profile_photo: currentBase64Photo
+                    })
+                });
+                
+                const result = await response.json();
+                
+                if (response.ok && result.success) {
+                    window.showToast(result.message, 'success');
+                    // State gÃ¼ncelle
+                    state.fullName = result.full_name;
+                    state.profilePhoto = result.profile_photo;
+                    // UI gÃ¼ncelle
+                    if (typeof updateProfileUI === 'function') updateProfileUI();
+                    
+                    closeProfileModal();
+                } else {
+                    window.showToast(result.message || 'Profil gÃ¼ncellenirken hata oluÅŸtu.', 'error');
+                }
+            } catch (error) {
+                console.error('Profil gÃ¼ncelleme hatasÄ±:', error);
+                window.showToast('Sunucu ile iletiÅŸim kurulamadÄ±.', 'error');
+            } finally {
+                saveBtn.disabled = false;
+                spinner.classList.add('hidden');
+            }
+        });
     }
